# API
PORT=8080
DATABASE_URL=postgres://help:help_local_only@localhost:5432/help?sslmode=disable
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10

# Habilite somente atrás de um proxy reverso confiável.
TRUST_PROXY_HEADERS=false

# Firebase Admin usa Application Default Credentials.
FIREBASE_PROJECT_ID=help-9c4d1
GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\seguro\firebase-service-account.json

# Nunca envie ou versione este token.
MAILERSEND_API_TOKEN=
MAILERSEND_FROM_EMAIL=nao-responda@vendlydigital.com.br
MAILERSEND_FROM_NAME=Help

# WebRTC. TURN_SHARED_SECRET deve ser o mesmo static-auth-secret do Coturn.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Mídia privada de chat, perfil e solicitações. Troque por object storage antes de escalar horizontalmente.
CHAT_MEDIA_DIR=.data/chat-media

# Matchmaking semântico é opcional; o ranking determinístico funciona sem IA.
MATCHMAKING_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=5
