# API
PORT=8080
DATABASE_URL=postgres://help:help_local_only@localhost:5432/help?sslmode=disable
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10

# Habilite somente atrás de um proxy reverso confiável.
TRUST_PROXY_HEADERS=false

# Firebase Admin usa Application Default Credentials.
FIREBASE_PROJECT_ID=help-9c4d1
GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\seguro\firebase-service-account.json

# Nunca envie ou versione este token.
MAILERSEND_API_TOKEN=
MAILERSEND_FROM_EMAIL=nao-responda@vendlydigital.com.br
MAILERSEND_FROM_NAME=Help
